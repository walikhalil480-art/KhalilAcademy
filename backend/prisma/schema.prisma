datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SUPER_ADMIN
  ADMIN
  INSTRUCTOR
  STUDENT
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum Level {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum ContentType {
  VIDEO
  TEXT
  PDF
  LINK
}

enum VideoSource {
  YOUTUBE
  UPLOAD
}

enum SubmissionStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  GRADED
  PASSED
  NEEDS_REVISION
  RETURNED
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
  REFUNDED
}

enum PaymentProvider {
  PAYSTACK
  MPESA
  PAYPAL
  CARD
  MOCK_PAYMENT
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum NotificationType {
  ENROLLMENT
  PAYMENT_SUCCESS
  PAYMENT_FAILED
  ASSIGNMENT_GRADED
  ASSIGNMENT_NEEDS_REVISION
  QUIZ_COMPLETED
  QUIZ_FAILED_SUPPORT
  COURSE_COMPLETED
  CERTIFICATE_ELIGIBLE
  CERTIFICATE_ISSUED
  ACCOUNT_VERIFICATION
  PASSWORD_RESET
  LIVE_CLASS_REMINDER_24H
  LIVE_CLASS_REMINDER_1H
  LIVE_CLASS_STARTING
  LIVE_CLASS_RECORDING_AVAILABLE
  LIVE_CLASS_CANCELLED
  STUDENT_SUPPORT_REMINDER
  ACHIEVEMENT_UNLOCKED
  LEVEL_UP
}

enum LiveSessionStatus {
  SCHEDULED
  LIVE
  COMPLETED
  CANCELLED
}

enum LiveMeetingProvider {
  ZOOM
  GOOGLE_MEET
  EXTERNAL
}

enum LiveAttendanceStatus {
  REGISTERED
  PRESENT
  PARTIAL
  ABSENT
}

model User {
  id                  String       @id @default(uuid())
  email               String       @unique
  passwordHash        String
  name                String
  role                Role         @default(STUDENT)
  status              UserStatus   @default(ACTIVE)
  failedLoginAttempts Int          @default(0)
  lockUntil           DateTime?
  emailVerified       Boolean      @default(false)
  verificationToken   String?
  resetToken          String?
  resetTokenExpiry    DateTime?
  avatar              String?
  bio                 String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  refreshTokens         RefreshToken[]
  createdCourses        Course[]               @relation("InstructorCourses")
  enrollments           Enrollment[]
  lessonProgresses      LessonProgress[]
  quizAttempts          QuizAttempt[]
  assignmentSubmissions AssignmentSubmission[] @relation("StudentSubmissions")
  gradedSubmissions     AssignmentSubmission[] @relation("GradedByInstructor")
  orders                Order[]
  certificates          Certificate[]
  reviews               Review[]
  notifications         Notification[]
  auditLogs             AuditLog[]
  aiConversations       AIConversation[]
  instructorLiveSessions LiveSession[]             @relation("InstructorLiveSessions")
  liveRegistrations      LiveSessionRegistration[]
  liveAttendances        LiveSessionAttendance[]
  liveQuestions          LiveSessionQuestion[]
  riskRecords            StudentRiskRecord[]
  gamificationProfile    UserGamificationProfile?
  activityDays           UserActivityDay[]
  badges                 UserBadge[]
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Category {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  description String?
  icon        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  courses Course[]
}

model Course {
  id                 String       @id @default(uuid())
  title              String
  slug               String       @unique
  description        String
  thumbnail          String?
  instructorId       String
  categoryId         String
  level              Level        @default(BEGINNER)
  isFree             Boolean      @default(false)
  price              Float        @default(0.0)
  discountPrice      Float?
  currency           String       @default("KES")
  durationHours      Float        @default(0.0)
  learningObjectives String[]
  requirements       String[]
  targetAudience     String[]
  status                      CourseStatus @default(DRAFT)
  completionCriteria          String?      @default("REQUIRED_LESSONS_AND_QUIZZES")
  certificateEnabled          Boolean      @default(true)
  requireAllLessons           Boolean      @default(true)
  requireQuizzes              Boolean      @default(false)
  quizPassingScore            Float        @default(70.0)
  requireAssignments          Boolean      @default(false)
  assignmentPassingScore      Float        @default(70.0)
  requireFinalAssessment      Boolean      @default(false)
  finalAssessmentPassingScore Float        @default(70.0)
  finalAssessmentQuizId       String?
  minimumProgressPercentage   Float        @default(100.0)
  createdAt                   DateTime     @default(now())
  updatedAt                   DateTime     @updatedAt

  instructor   User          @relation("InstructorCourses", fields: [instructorId], references: [id])
  category     Category      @relation(fields: [categoryId], references: [id])
  modules      Module[]
  quizzes      Quiz[]
  assignments  Assignment[]
  enrollments  Enrollment[]
  orders       Order[]
  certificates Certificate[]
  reviews      Review[]
  aiConversations AIConversation[]
  liveSessions LiveSession[]
  riskRecords  StudentRiskRecord[]
}

model Module {
  id          String   @id @default(uuid())
  title       String
  description String?
  order       Int
  courseId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course      Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons     Lesson[]
  quizzes     Quiz[]
  assignments Assignment[]
}

model Lesson {
  id                  String      @id @default(uuid())
  title               String
  description         String?
  contentType         ContentType @default(VIDEO)
  videoSource         VideoSource @default(YOUTUBE)
  youtubeVideoId      String?
  videoUrl            String?
  storageKey          String?
  fileName            String?
  fileSize            Int?
  mimeType            String?
  textContent         String?
  notes               String?
  transcript          String?
  resourceUrl         String?
  isPreview           Boolean     @default(false)
  isRequired          Boolean     @default(true)
  durationMinutes     Int         @default(0)
  order               Int
  isPublished         Boolean     @default(true)
  moduleId            String
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  module     Module           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progresses LessonProgress[]
  resources  LessonResource[]
  aiConversations AIConversation[]
}

model LessonResource {
  id          String   @id @default(uuid())
  lessonId    String
  title       String
  fileUrl     String
  storageKey  String?
  fileName    String?
  fileSize    Int?
  mimeType    String?
  createdAt   DateTime @default(now())

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
}

model LessonProgress {
  id                  String    @id @default(uuid())
  userId              String
  lessonId            String
  isCompleted         Boolean   @default(false)
  completedAt         DateTime?
  lastWatchedPosition Int       @default(0)
  watchTime           Int       @default(0)
  progressPercentage  Float     @default(0.0)
  status              String    @default("NOT_STARTED")
  lastHeartbeatAt     DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
}

model Quiz {
  id                String   @id @default(uuid())
  title             String
  description       String?
  passingScore      Float    @default(70.0)
  timeLimitMinutes  Int      @default(30)
  maxAttempts       Int      @default(3)
  isRequired        Boolean  @default(true)
  isFinalAssessment Boolean  @default(false)
  moduleId          String
  courseId          String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  module      Module              @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  course      Course              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  questions   QuizQuestion[]
  attempts    QuizAttempt[]
  riskRecords StudentRiskRecord[]
}

model QuizQuestion {
  id           String   @id @default(uuid())
  quizId       String
  questionText String
  points       Float    @default(1.0)
  order        Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  quiz    Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  options QuizOption[]
  answers QuizAnswer[]
}

model QuizOption {
  id           String   @id @default(uuid())
  questionId   String
  optionText   String
  isCorrect    Boolean  @default(false)
  explanation  String?
  createdAt    DateTime @default(now())

  question QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answers  QuizAnswer[]
}

model QuizAttempt {
  id          String   @id @default(uuid())
  quizId      String
  userId      String
  score       Float
  maxScore    Float
  percentage  Float
  passed      Boolean
  startedAt   DateTime @default(now())
  completedAt DateTime @default(now())

  quiz    Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers QuizAnswer[]
}

model QuizAnswer {
  id               String  @id @default(uuid())
  attemptId        String
  questionId       String
  selectedOptionId String?
  isCorrect        Boolean @default(false)

  attempt        QuizAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question       QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOption QuizOption?  @relation(fields: [selectedOptionId], references: [id], onDelete: SetNull)
}

model Assignment {
  id               String    @id @default(uuid())
  title            String
  instructions     String
  dueDate          DateTime?
  maxScore         Float     @default(100.0)
  passingScore     Float     @default(70.0)
  isRequired       Boolean   @default(true)
  allowedFileTypes String[]  @default(["pdf", "zip", "docx", "txt"])
  maxFileSizeBytes Int       @default(10485760) // 10 MB
  moduleId         String
  courseId         String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  module      Module                 @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  course      Course                 @relation(fields: [courseId], references: [id], onDelete: Cascade)
  submissions AssignmentSubmission[]
  riskRecords StudentRiskRecord[]
}

model AssignmentSubmission {
  id                 String           @id @default(uuid())
  assignmentId       String
  userId             String
  submissionText     String?
  fileUrl            String?
  status             SubmissionStatus @default(SUBMITTED)
  score              Float?
  feedback           String?
  submissionAttempts Int              @default(1)
  submittedAt        DateTime         @default(now())
  gradedAt           DateTime?
  gradedByUserId     String?

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  user       User       @relation("StudentSubmissions", fields: [userId], references: [id], onDelete: Cascade)
  gradedBy   User?      @relation("GradedByInstructor", fields: [gradedByUserId], references: [id], onDelete: SetNull)
}

model Enrollment {
  id                 String           @id @default(uuid())
  userId             String
  courseId           String
  status             EnrollmentStatus @default(ACTIVE)
  completedAt        DateTime?
  progressPercentage Float            @default(0.0)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

model Order {
  id             String      @id @default(uuid())
  orderNumber    String      @unique
  userId         String
  courseId       String
  originalPrice  Float
  discountAmount Float       @default(0.0)
  finalPrice     Float
  couponCode     String?
  status         OrderStatus @default(PENDING)
  createdAt      DateTime    @default(now())

  user     User      @relation(fields: [userId], references: [id])
  course   Course    @relation(fields: [courseId], references: [id])
  payments Payment[]
}

model Payment {
  id                    String          @id @default(uuid())
  orderId               String
  paymentProvider       PaymentProvider @default(PAYSTACK)
  providerTransactionId String?         @unique
  transactionId         String          @unique
  status                PaymentStatus   @default(PENDING)
  amount                Float
  currency              String          @default("KES")
  rawWebhookPayload     String?
  metadata              String?
  paidAt                DateTime?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @default(now()) @updatedAt

  order Order @relation(fields: [orderId], references: [id])
}

model Coupon {
  id                String       @id @default(uuid())
  code              String       @unique
  discountType      DiscountType @default(PERCENTAGE)
  discountValue     Float
  minPurchaseAmount Float        @default(0.0)
  maxUses           Int          @default(100)
  currentUses       Int          @default(0)
  expiresAt         DateTime?
  isActive          Boolean      @default(true)
  createdAt         DateTime     @default(now())
}

model Certificate {
  id                String   @id @default(uuid())
  certificateNumber String   @unique
  userId            String
  courseId          String
  studentName       String
  courseTitle       String
  instructorName    String
  issueDate         DateTime @default(now())
  isRevoked         Boolean  @default(false)
  revocationReason  String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now()) @updatedAt

  user   User   @relation(fields: [userId], references: [id])
  course Course @relation(fields: [courseId], references: [id])

  @@unique([userId, courseId])
}

model Review {
  id          String   @id @default(uuid())
  userId      String
  courseId    String
  rating      Int
  comment     String
  isModerated Boolean  @default(true)
  createdAt   DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  title     String
  message   String
  type      NotificationType
  isRead    Boolean          @default(false)
  linkUrl   String?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  ipAddress String?
  userAgent String?
  details   String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}

enum AIMessageRole {
  USER
  ASSISTANT
  SYSTEM
}

model AIConversation {
  id        String      @id @default(uuid())
  userId    String
  courseId  String?
  lessonId  String?
  title     String      @default("New Chat")
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  course    Course?     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lesson    Lesson?     @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  messages  AIMessage[]

  @@index([userId])
  @@index([courseId])
  @@index([lessonId])
}

model AIMessage {
  id             String         @id @default(uuid())
  conversationId String
  role           AIMessageRole  @default(USER)
  content        String
  actionType     String?        // EXPLAIN, SIMPLIFY, SUMMARY, QUIZ, CODE_HELP, STUDY_PLAN, RECOMMENDATION, GENERAL
  contextMeta    String?        // JSON string metadata for code, topic, score etc.
  createdAt      DateTime       @default(now())

  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model LiveSession {
  id                         String              @id @default(uuid())
  title                      String
  description                String?
  courseId                   String
  instructorId               String
  startTime                  DateTime
  endTime                    DateTime
  timezone                   String              @default("UTC")
  maxParticipants            Int                 @default(50)
  meetingProvider            LiveMeetingProvider @default(EXTERNAL)
  meetingUrl                 String?             // Sensitive: returned only to registered/authorized users
  meetingId                  String?
  meetingPasscode            String?
  status                     LiveSessionStatus   @default(SCHEDULED)
  attendanceThresholdPercent Int                 @default(70)
  joinBufferMinutes          Int                 @default(15)
  recordingUrl               String?
  recordingTitle             String?
  recordingDurationMinutes   Int?
  recordingUploadedAt        DateTime?
  createdAt                  DateTime            @default(now())
  updatedAt                  DateTime            @updatedAt

  course        Course                    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  instructor    User                      @relation("InstructorLiveSessions", fields: [instructorId], references: [id], onDelete: Cascade)
  registrations LiveSessionRegistration[]
  attendances   LiveSessionAttendance[]
  questions     LiveSessionQuestion[]

  @@index([courseId])
  @@index([instructorId])
  @@index([status])
  @@index([startTime])
}

model LiveSessionRegistration {
  id                   String      @id @default(uuid())
  sessionId            String
  userId               String
  registeredAt         DateTime    @default(now())
  reminder24hSent      Boolean     @default(false)
  reminder1hSent       Boolean     @default(false)
  reminderStartingSent Boolean     @default(false)
  status               String      @default("REGISTERED")
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  session LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])
  @@index([sessionId])
  @@index([userId])
}

model LiveSessionAttendance {
  id              String               @id @default(uuid())
  sessionId       String
  userId          String
  joinedAt        DateTime             @default(now())
  leftAt          DateTime?
  durationMinutes Int                  @default(0)
  status          LiveAttendanceStatus @default(REGISTERED)
  markedBy        String?              // "SYSTEM" or instructor userId
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  session LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])
  @@index([sessionId])
  @@index([userId])
}

model LiveSessionQuestion {
  id             String      @id @default(uuid())
  sessionId      String
  userId         String
  question       String
  answer         String?
  answeredBy     String?     // Instructor name or user ID
  answeredAt     DateTime?
  isAnswered     Boolean     @default(false)
  isPinned       Boolean     @default(false)
  upvotes        Int         @default(0)
  upvotedUserIds String[]    @default([])
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  session LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([userId])
  @@index([isPinned])
}

enum StudentRiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum StudentRiskStatus {
  ACTIVE
  RESOLVED
  DISMISSED
}

enum StudentRiskReason {
  INACTIVE_10_DAYS
  COURSE_PROGRESS_STALLED
  QUIZ_FAILED_3_TIMES
  ASSIGNMENT_OVERDUE
  LOW_RECENT_PERFORMANCE
  MULTIPLE_RISK_FACTORS
}

model StudentRiskRecord {
  id                String            @id @default(uuid())
  userId            String
  courseId          String?
  quizId            String?
  assignmentId      String?
  riskLevel         StudentRiskLevel
  riskReason        StudentRiskReason
  title             String
  details           String
  metricValue       Float?
  status            StudentRiskStatus @default(ACTIVE)
  detectedAt        DateTime          @default(now())
  resolvedAt        DateTime?
  resolutionReason  String?
  lastNotifiedAt    DateTime?
  notificationCount Int               @default(0)
  recommendedAction String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  course     Course?     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  quiz       Quiz?       @relation(fields: [quizId], references: [id], onDelete: Cascade)
  assignment Assignment? @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([riskLevel])
  @@index([status])
  @@index([courseId])
  @@index([detectedAt])
}

// -------------------------------------------------------------
// Gamification, Streaks & Achievement Models
// -------------------------------------------------------------

enum BadgeType {
  FIRST_LESSON
  FIRST_COURSE
  STREAK_3
  STREAK_7
  STREAK_30
  QUIZ_MASTER
  PERFECT_ASSIGNMENT
  SPEED_LEARNER
  MULTI_CERTIFIED
  LIVE_CLASS_ATTENDEE
}

model UserGamificationProfile {
  id                 String    @id @default(uuid())
  userId             String    @unique
  xpPoints           Int       @default(0)
  level              Int       @default(1)
  levelTitle         String    @default("Novice")
  currentStreakDays  Int       @default(0)
  longestStreakDays  Int       @default(0)
  lastActiveDate     String?   // YYYY-MM-DD
  weeklyGoalMinutes  Int       @default(120) // Default 2 hours / week
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([xpPoints])
  @@index([currentStreakDays])
}

model UserActivityDay {
  id                   String   @id @default(uuid())
  userId               String
  date                 String   // YYYY-MM-DD
  minutesLearned       Int      @default(0)
  lessonsCompleted     Int      @default(0)
  quizzesTaken         Int      @default(0)
  assignmentsCompleted Int      @default(0)
  xpEarned             Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
}

model UserBadge {
  id          String    @id @default(uuid())
  userId      String
  badgeType   BadgeType
  title       String
  description String
  icon        String    // Emoji or icon name (e.g. '🔥', '🎓', '🎯')
  category    String    @default("ACHIEVEMENT")
  earnedAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeType])
  @@index([userId])
  @@index([badgeType])
}
